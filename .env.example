# hospital-api base URL (dev default: http://localhost:4200; prod: https://hospitalapi.codevertexafrica.com)
NEXT_PUBLIC_API_URL=http://localhost:4200

# auth-api / SSO base URL — also used for tenant branding lookups (GET /api/v1/tenants/by-slug/{slug})
NEXT_PUBLIC_AUTH_URL=https://sso.codevertexafrica.com

# OIDC client id registered with auth-api for this frontend
NEXT_PUBLIC_SSO_CLIENT_ID=hospital-ui

# Optional default tenant slug used by the root "/" redirect
NEXT_PUBLIC_TENANT_SLUG=codevertex-demo
